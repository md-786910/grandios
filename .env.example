# Copy to .env and fill in. Generate each password with: openssl rand -hex 24

MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=

MONGO_DB_NAME=grandios_live_latest
MONGO_APP_USER=grandios_app
MONGO_APP_PASSWORD=

ME_BASIC_AUTH_USER=admin
ME_BASIC_AUTH_PASSWORD=

# Then in server/.env:
# MONGODB_URI=mongodb://grandios_app:<MONGO_APP_PASSWORD>@127.0.0.1:27018/grandios_live_latest?authSource=grandios_live_latest

BACKUP_HOUR=2
BACKUP_RETENTION_DAYS=30
